---
import Head from '../components/Head.astro';
import LayoutLight from '../layouts/LayoutLight.astro';
import SmallHero from '../components/SmallHero.astro';

const title = 'Projects';
const subtitle = "Apps I'm building and releasing, plus small experiments and other fun stuff.";

const apps = [
	{
		name: "Windowpane",
		description: "Custom window commands for macOS — a lightweight, open-source menu-bar app. Resize and move the focused window into any layout, triggered with global hotkeys, a quick picker, or a URL.",
		url: "https://github.com/jeksn/windowpane"
	},
	{
		name: "Feedwire (beta)",
		description: "A lightweight, native macOS RSS/Atom feed reader built with Tauri, React and Rust. Tracks RSS feeds and YouTube channels, with OPML import/export, folders and article filtering. Inspired by NetNewsWire, but with the features I wish it had.",
		url: "https://feedwire.jek.sn"
	},
	{
		name: "Eklipse",
		description: "A browser extension that strips away distractions and puts you back in control of your YouTube experience — hide the home feed, limit recommendations, disable autoplay and more.",
		url: "https://eklipse.jek.sn"
	}
];

const smallProjects = [
	{
		name: "Hat Stack",
		description: "A simple starter template based on Alpine.js, Tailwind and Handlebars.",
		url: "https://github.com/jeksn/HatStack"
	},
	{
		name: "Alpinist",
		description: "A collection of Alpine.js components.",
		url: "https://alpinist.jeksn.me"
	},
	{
		name: "Weeek",
		description: "Small site that displays the week number.",
		url: "https://week.jeksn.me"
	}
];
---

<LayoutLight>
	<Head slot="head" title={title} />
	<SmallHero title={title} subtitle={subtitle} />
	<section class="pt-12 pb-16 px-4">
		<div class="mt-6 max-w-screen-lg mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-5 gap-8">
				<!-- Left sidebar with static content -->
				<div class="md:col-span-1">
					<div class="sticky top-24 space-y-8">
						<div>
							<h3 class="text-lg font-medium text-orange-100 mb-4 font-departure">Projects</h3>
							<p class="text-sm text-[#939393] font-departure">Software I'm building and releasing, plus small things I made for fun.</p>
						</div>
					</div>
				</div>

				<!-- Right content area with apps and projects -->
				<div class="md:col-span-4">
					<div class="space-y-12">
						<div>
							<ul class="space-y-4">
								{apps.map((app) => (
									<li class="grid grid-cols-1 text-sm gap-2">
										<div class="space-y-1">
											{app.url ? (
												<a href={app.url} target="_blank" class="text-orange-100 font-departure hover:underline flex gap-1"><span>{app.name}</span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
											) : (
												<span class="text-orange-100 font-departure">{app.name}</span>
											)}
											<p class="text-[#939393] font-departure">{app.description}</p>
										</div>
									</li>
								))}
							</ul>
						</div>
						<div>
							<h3 class="text-orange-100 font-departure mb-4">Small stuff, just for fun</h3>
							<ul class="space-y-4">
								{smallProjects.map((project) => (
									<li class="grid grid-cols-1 text-sm gap-2">
										<div class="space-y-1">
											{project.url ? (
												<a href={project.url} target="_blank" class="text-orange-100 font-departure hover:underline flex gap-1"><span>{project.name}</span><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up-right-icon lucide-arrow-up-right"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg></a>
											) : (
												<span class="text-orange-100 font-departure">{project.name}</span>
											)}
											<p class="text-[#939393] font-departure">{project.description}</p>
										</div>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</LayoutLight>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
