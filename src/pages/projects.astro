---
import Head from '../components/Head.astro';
import LayoutLight from '../layouts/LayoutLight.astro';
import SmallHero from '../components/SmallHero.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';
import ProjectsData from '../../public/data/projects.json';

const title = 'Apps & Projects';
const subtitle = "Apps I'm building and releasing, plus small experiments and other fun stuff.";

const apps = ProjectsData.apps;
const smallProjects = ProjectsData.smallProjects;
---

<LayoutLight>
	<Head slot="head" title={title} />
	<SmallHero title={title} subtitle={subtitle} />
	<section class="pt-12 pb-16 px-4">
		<div class="mt-6 max-w-screen-lg mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-5 gap-8">
				<!-- Left sidebar with static content -->
				<div class="md:col-span-1">
					<div class="sticky top-24 space-y-8">
						<div>
							<ul class="space-y-2">
								<li>
									<a href="#apps" class="text-sm text-[#939393] hover:text-orange-100 hover:underline transition-colors font-departure">
										Apps
									</a>
								</li>
								<li>
									<a href="#small-projects" class="text-sm text-[#939393] hover:text-orange-100 hover:underline transition-colors font-departure">
										Small projects
									</a>
								</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Right content area with apps and projects -->
				<div class="md:col-span-4">
					<div class="space-y-12">
						<div id="apps" class="scroll-mt-24">
							<ul class="space-y-8">
								{apps.map((app) => (
									<li class="grid grid-cols-1 text-sm gap-2">
										<div class="space-y-1">
											{app.url ? (
												<a href={app.url} target="_blank" class="text-orange-100 font-departure hover:underline flex gap-1"><span>{app.name}</span><ArrowUpRight /></a>
											) : (
												<span class="text-orange-100 font-departure">{app.name}</span>
											)}
											<p class="text-[#939393]">{app.description}</p>
										</div>
									</li>
								))}
							</ul>
						</div>
						{smallProjects.length > 0 && (
						<div id="small-projects" class="scroll-mt-24">
							<h3 class="text-orange-100 font-departure mb-4">Small projects</h3>
							<ul class="space-y-8">
								{smallProjects.map((project) => (
									<li class="grid grid-cols-1 text-sm gap-2">
										<div class="space-y-1">
											{project.url ? (
												<a href={project.url} target="_blank" class="text-orange-100 font-departure hover:underline flex gap-1"><span>{project.name}</span><ArrowUpRight /></a>
											) : (
												<span class="text-orange-100 font-departure">{project.name}</span>
											)}
											<p class="text-[#939393]">{project.description}</p>
										</div>
									</li>
								))}
							</ul>
						</div>
						)}
					</div>
				</div>
			</div>
		</div>
	</section>
</LayoutLight>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
