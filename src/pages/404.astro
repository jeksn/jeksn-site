---
import Head from '../components/Head.astro';
import LayoutLight from '../layouts/LayoutLight.astro';
import SmallHero from '../components/SmallHero.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';

const title = '404';
const subtitle = "This page doesn't exist or has been moved.";
---

<LayoutLight>
	<Head slot="head" title={title} />
	<SmallHero title={title} subtitle={subtitle} />
	<section class="pt-12 pb-16 px-4">
		<div class="mt-6 max-w-screen-lg mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-5 gap-8">
				<!-- Left sidebar with static content -->
				<div class="md:col-span-1">
					<div class="sticky top-24 space-y-8">
						<div>
							<h3 class="text-lg font-medium text-orange-100 mb-4 font-departure">Lost?</h3>
							<p class="text-sm text-[#939393] font-departure">The page you're looking for isn't here. Try one of the links on the right.</p>
						</div>
					</div>
				</div>

				<!-- Right content area with links -->
				<div class="md:col-span-4">
					<div class="space-y-8">
						<div>
							<ul class="space-y-4">
								<li class="grid grid-cols-1 text-sm gap-2">
									<div class="space-y-1">
										<a href="/" class="text-orange-100 font-departure hover:underline flex gap-1"><span>Back home</span><ArrowUpRight /></a>
										<p class="text-[#939393] font-departure">Head back to the start.</p>
									</div>
								</li>
								<li class="grid grid-cols-1 text-sm gap-2">
									<div class="space-y-1">
										<a href="/blog" class="text-orange-100 font-departure hover:underline flex gap-1"><span>Blog</span><ArrowUpRight /></a>
										<p class="text-[#939393] font-departure">Notes and posts.</p>
									</div>
								</li>
								<li class="grid grid-cols-1 text-sm gap-2">
									<div class="space-y-1">
										<a href="/projects" class="text-orange-100 font-departure hover:underline flex gap-1"><span>Projects</span><ArrowUpRight /></a>
										<p class="text-[#939393] font-departure">Apps, side projects and experiments.</p>
									</div>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</LayoutLight>

<style>
	html {
		scroll-behavior: smooth;
	}
</style>
