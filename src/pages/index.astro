---
import Head from '../components/Head.astro';
import LayoutLight from '../layouts/LayoutLight.astro';
import SmallHero from '../components/SmallHero.astro';
import ArrowUpRight from '../components/ArrowUpRight.astro';

const title = 'Home';
const subtitle = "jeksn.me";

const links = [
	{ name: 'Blog', url: '/blog', desc: 'My infrequent writings.' },
	{ name: 'Apps & Projects', url: '/projects', desc: "Apps I'm building and releasing, plus small experiments and other fun stuff.", span: 'sm:col-span-2' },
	{ name: 'Reading List', url: '/reading-list', desc: "My list of books I've read and am currently reading." },
	{ name: 'Now', url: '/now', desc: "What I'm currently focusing on." },
	{ name: 'CV', url: '/cv', desc: 'Work experience, education and contact.' }
];
---

<LayoutLight>
	<Head slot="head" title="Johan Eriksson" />
	<div class="pt-20 px-4 mb-4 bg-zinc-900">
		<div class="max-w-screen-lg text-left space-y-4 mx-auto">
			<h1 class="py-2 text-3xl md:text-5xl text-orange-100 font-departure"><span class="text-orange-100/30 font-departure animate-pulse">https://</span>jeksn.me<span class="text-orange-100/30 font-departure animate-pulse">/</span></h1>
		</div>
	</div>
	<section class="pt-12 pb-16 px-4">
		<div class="mt-6 max-w-screen-lg mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-5 gap-8">
				<!-- Left sidebar with static content -->
				<div class="md:col-span-1">
					<div class="sticky top-24 space-y-8">
						<div>
							<div class="text-sm text-[#939393]">
								<h3 class="text-orange-100 font-departure">I still believe in the value of the personal website* and this is my ever changing part of the web.</h3>
								<button
									aria-label="Copy email address"
									x-data="{ copied: false }"
									@click="navigator.clipboard.writeText('johan@jeksn.me'); copied = true; setTimeout(() => copied = false, 2000)"
									class="mt-4 text-sm flex items-center gap-2 px-4 py-2 rounded-full bg-orange-100 text-zinc-900 hover:bg-orange-100/90 transition-colors">
									<span x-show="!copied">Get in touch</span>
									<span x-show="copied">Email copied!</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" x-show="!copied"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" x-show="copied"><path d="M20 6 9 17l-5-5"/></svg>
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Right content area with links -->
				<div class="md:col-span-4">
					<div class="space-y-8">
						<div>
							<ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
								{links.map((link) => (
									<li class={link.span ?? ''}>
									<a href={link.url} class="flex h-full flex-col justify-end min-h-[220px] p-8 rounded-xl bg-black/20 border border-white/10 hover:bg-black/30 hover:border-white/20 transition-colors">
										<span class="text-sm text-orange-100 font-departure flex gap-1 mb-2">
											{link.name}
											<ArrowUpRight />
										</span>
										<p class="text-sm text-[#939393]">{link.desc}</p>
									</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</LayoutLight>
